# ========================================================
# Rangers Store POS - Environment Variables
# ========================================================

# Neon PostgreSQL Serverless Connection String
# Dapatkan dari dashboard Neon (https://console.neon.tech)
DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Midtrans Sandbox Credentials
# Dapatkan dari Midtrans Dashboard -> Settings -> Access Keys (Environment: Sandbox)
MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key-here"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key-here"

# Base URL Aplikasi (default localhost:3000 saat development)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
